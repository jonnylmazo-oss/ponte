# Keep source-only files out of the deployment (they'd otherwise be served as
# public static assets at the repo root). Only list files that NO serverless
# function imports — Node File Trace can only bundle files that are uploaded, so
# anything required by /api (e.g. lib/ponte.js) must NOT be excluded here.
server.js
backfill.js

# One-time local data scripts + their artifacts. These are also in .gitignore
# (except backfill-audio-script.js), so the git auto-deploy never sees them —
# but because this .vercelignore exists, the Vercel CLI stops falling back to
# .gitignore, so `vercel --prod` from a workstation WOULD upload and publicly
# serve them. Listed here to close that path.
generate-deck.js
push-deck.js
migrate-taxonomy.js
backfill-audio-script.js
backfill-audio-elevenlabs.js
backfill-examples.js
generate-beginner-stories.js
backfill-story-audio-script.js
backfill-story-audio-elevenlabs.js
generated-deck.json
audio-backfill/
