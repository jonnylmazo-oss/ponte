# Ponte environment variables
# Copy to .env for local dev, or set these in the Vercel dashboard for production.
# (Do NOT commit real values — this file lists placeholders only.)

# Anthropic API key used for all Claude calls
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Password required to reach authenticated endpoints (flashcards + generation)
PONTE_PASSWORD=change-me

# HMAC secret for deriving Bearer tokens — must NOT be empty or "dev-secret-change-me"
PONTE_SESSION_SECRET=generate-a-long-random-string

# Upstash Redis (flashcard storage). The Vercel ↔ Upstash integration provisions
# these automatically for the deployed project — you only need to set them by hand
# for local `vercel dev` / `npm start` against a real store.
KV_REST_API_URL=https://your-db.upstash.io
KV_REST_API_TOKEN=your-upstash-rest-token
